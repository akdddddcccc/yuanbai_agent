[Unit]
Description=Yuanbai Explore leaderboard
After=network.target

[Service]
Type=simple
User=yuanbai
Group=yuanbai
WorkingDirectory=/opt/yuanbai-leaderboard/current
Environment=NODE_ENV=production
Environment=APP_ORIGIN=https://apps-demo.muyang23333.top
Environment=DB_PATH=/var/lib/yuanbai/leaderboard.sqlite
Environment=PORT=4174
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/yuanbai-runtime/node-v24.16.0-linux-x64/bin/node services/leaderboard/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yuanbai
PrivateTmp=true
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
