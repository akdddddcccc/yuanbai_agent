[Unit]
Description=Yuanbai Explore leaderboard
After=network.target

[Service]
Type=simple
User=yuanbai
Group=yuanbai
WorkingDirectory=/opt/yuanbai_agent
Environment=NODE_ENV=production
Environment=APP_ORIGIN=https://apps-demo.muyang23333.top
Environment=DB_PATH=/var/lib/yuanbai/leaderboard.sqlite
Environment=PORT=4174
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node services/leaderboard/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yuanbai
PrivateTmp=true

[Install]
WantedBy=multi-user.target
